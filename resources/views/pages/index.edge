  <!-- Contenido Principal -->
  <main class="w-full max-w-6xl mx-auto px-6 md:px-12 py-8 relative z-10 flex-grow flex flex-col justify-center">

    <!-- Sección de Perfil / Cabecera -->
    <div class="card flex flex-col md:flex-row items-center md:items-start gap-44 mb-10">
