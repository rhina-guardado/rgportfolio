  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>

  <script>
    gsap.registerPlugin(ScrollTrigger);

    // Recorre cada tarjeta para que cada una tenga su propio trigger
    gsap.utils.toArray(".card").forEach((card) => {
      gsap.from(card, {
        y: 60,            // sube desde 60px abajo
        opacity: 0,
        duration: 0.8,
        ease: "power3.out",
        scrollTrigger: {
          trigger: card,
          start: "top 85%",   // cuando el top de la tarjeta llega al 85% de la pantalla
          toggleActions: "play none none none"
        },
        // Tus tarjetas tienen "transition-all" de Tailwind y pelea con GSAP
        onStart: () => (card.style.transition = "none"),
        onComplete: () => (card.style.transition = "")
      });
    });
  </script>
</body>