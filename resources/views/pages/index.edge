      <div class="relative flex-shrink-0">
        <div
          class="w-60 h-60 rounded-full p-1 bg-[linear-gradient(135deg,#38bdf8,#a855f7,#ec4899,#facc15)] shadow-[0_0_25px_rgba(168,85,247,0.5),0_0_50px_rgba(56,189,248,0.3)] flex items-center justify-center overflow-hidden">
          <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&q=80&w=500"
            onerror="this.src='https://placehold.co/400x400/2a1b4e/fff?text=Rhina'" alt="Avatar"
            class="w-full h-full object-cover rounded-full">
        </div>
      </div>

      <!-- Saludo y Nombre -->
      <div class="flex flex-col mt-12  justify-end text-center pt-2 ">
        <div class="relative inline-block mb-6">
          <span
            class="text-lg font-light text-white/80 tracking-widest underline decoration-purple-400 decoration-1 underline-offset-4">
            Hello! I Am
          </span>
        </div>
        <h1
          class="text-6xl font-heading font-bold text-white tracking-wide mt-1 drop-shadow-[0_0_15px_rgba(168,85,247,0.5)]">
          Rhina Guardado
        </h1>
        <h1 class="text-sm  mx-4 font-sans  text-white tracking-wide mt-2 drop-shadow-[0_0_15px_rgba(168,85,247,0.5)]">
          Even if I´m not chosen, even if I have no magic,
          I'll prove that I can stand at the top
        </h1>
      </div>
    </div>

    <!-- Subtítulo -->
    <div class="card mb-12">
      <h2 class="text-5xl  font-heading font-medium text-white/90 drop-shadow-[0_0_15px_rgba(168,85,247,0.5)]">
        I'm a student
      </h2>
    </div>

    <!-- Descripción -->
    <div class="card max-w-3xl mb-16">
      <p class="text-white/70 text-lg/8  font-normal tracking-wide drop-shadow-[0_0_15px_rgba(168,85,247,0.5)]">
        Passionate about technology, problem solving, and mathematical analysis.
        I stand out for my ability to learn quickly, adapt to new tools and environments,
        and remain proactive. I am about to start my university career to specialize in
        backend development and cybersecurity.
      </p>
    </div>




















