<!DOCTYPE html>
<html lang="en" class="scroll-smooth">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Portfolio - Rhina Guardado</title>
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <link
    href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@300;400;500;600&display=swap"
    rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'sans-serif'],
            heading: ['Space Grotesk', 'sans-serif'],
          }
        }
      }
    }
  </script>
</head>

<body
  class="bg-[#05030b] bg-[radial-gradient(ellipse_at_top,rgba(168,85,247,0.14),transparent_55%),radial-gradient(ellipse_at_bottom_right,rgba(0,255,102,0.07),transparent_50%)] text-white font-sans min-h-screen relative overflow-x-hidden flex flex-col justify-between selection:bg-purple-500 selection:text-white">

  <!-- Header fuera de main para que abarque todo el ancho de la pantalla -->
  <header class="w-full px-8 md:px-14 pt-8 pb-6 flex justify-center items-center relative z-10">
        
            
        <nav class="hidden md:flex items-center space-x-10 text-lg font-medium text-white/80">
            <a href="/"
                class="transition-all duration-300 hover:text-white hover:[text-shadow:0_0_15px_rgba(168,85,247,0.8)]">About</a>
            <a href="/certifications"
                class="transition-all duration-300 hover:text-white hover:[text-shadow:0_0_15px_rgba(168,85,247,0.8)]">Certifications</a>
            <a href="/projects"
                class="transition-all duration-300 hover:text-white hover:[text-shadow:0_0_15px_rgba(168,85,247,0.8)]">Projects</a>
        </nav>
    </header>

  <main class="w-full max-w-6xl mx-auto px-6 md:px-12 py-8 relative z-10 flex-grow flex flex-col justify-center gap-6 mb-12">

    <!-- Tarjeta 1: Celeste Neón -->
    <article
      class="card border border-[#00f0ff]/40 bg-[linear-gradient(135deg,rgba(5,20,30,0.72)_0%,rgba(2,10,15,0.88)_100%)] backdrop-blur-md rounded-2xl p-6 md:p-7 flex flex-col justify-between shadow-[0_0_15px_rgba(0,240,255,0.15)] hover:border-[#00f0ff] hover:shadow-[0_0_25px_rgba(0,240,255,0.35)] transition-all">
      <div class="flex flex-col md:flex-row gap-8 items-start md:items-center">
        <div class="relative flex-shrink-0 w-full md:w-[300px]">
          <img src="/images/hackaton.png" alt="Dress to Impress preview"
            class="w-full h-44 object-cover rounded-2xl border border-[#00f0ff]/30 drop-shadow-[0_0_8px_rgba(0,240,255,0.65)]" />
        </div>

        <div class="flex flex-col">
          <span class="font-sans text-xs md:text-sm tracking-[0.2em] uppercase font-medium text-[#00f0ff] mb-2">
            Hackaton
          </span>

          <h2 class="font-heading text-xl md:text-2xl tracking-wider uppercase font-bold text-[#00f0ff] mb-3 drop-shadow-[0_0_10px_rgba(0,240,255,0.3)]">
            Dress to Impress
          </h2>

          <p class="font-sans text-white/75 text-sm md:text-base leading-relaxed font-normal mb-6">
            It is a group web application carried out in 2024 and developed in about 6 months using technological
            tools such as Figma, Power Apps, and SharePoint.
          </p>

          <div>
            <a href="/imdress"
              class="inline-block border rounded-2xl px-4 py-2 text-sm md:text-base font-medium border-[#00f0ff]/40 text-[#00f0ff] hover:border-[#00f0ff] hover:drop-shadow-[0_0_8px_rgba(0,240,255,0.8)] transition-all">
              Learn more
            </a>
          </div>
        </div>
      </div>
    </article>

    <!-- Tarjeta 2: Morado (#a855f7) -->
    <article
      class="card border border-purple-500/50 bg-[linear-gradient(135deg,rgba(20,10,38,0.72)_0%,rgba(10,5,20,0.88)_100%)] backdrop-blur-md rounded-2xl p-6 md:p-7 flex flex-col justify-between shadow-[0_0_15px_rgba(168,85,247,0.16)] hover:border-purple-400 hover:shadow-[0_0_25px_rgba(168,85,247,0.35)] transition-all">
      <div class="flex flex-col md:flex-row gap-8 items-start md:items-center">
        <div class="relative flex-shrink-0 w-full md:w-[300px]">
          <img src="/images/dtod.png" alt="Door to Door Prototype preview"
            class="w-full h-44 object-cover rounded-2xl border border-purple-500/30 drop-shadow-[0_0_8px_#a855f7cc]" />
        </div>

        <div class="flex flex-col">
          <span class="font-sans text-xs md:text-sm tracking-[0.2em] uppercase font-medium text-[#a855f7] mb-2">
            Expo Logros
          </span>

          <h2 class="font-heading text-xl md:text-2xl tracking-wider uppercase font-bold text-[#a855f7] mb-3 drop-shadow-[0_0_10px_rgba(168,85,247,0.35)]">
            Door to Door - Prototype
          </h2>

          <p class="font-sans text-white/75 text-sm md:text-base leading-relaxed font-normal mb-6">
            A group web project born out of nostalgia and the lack of access to Salvadoran products for our people
            living abroad.
          </p>

          <div>
            <a href="/dtod"
              class="inline-block border rounded-2xl px-4 py-2 text-sm md:text-base font-medium border-[#a855f7]/40 text-[#a855f7] hover:border-[#a855f7] hover:drop-shadow-[0_0_8px_#a855f7cc] transition-all">
              Learn more
            </a>
          </div>
        </div>
      </div>
    </article>

    <!-- Tarjeta 3: Celeste Neón -->
    <article
      class="card border border-[#00f0ff]/40 bg-[linear-gradient(135deg,rgba(5,20,30,0.72)_0%,rgba(2,10,15,0.88)_100%)] backdrop-blur-md rounded-2xl p-6 md:p-7 flex flex-col justify-between shadow-[0_0_15px_rgba(0,240,255,0.15)] hover:border-[#00f0ff] hover:shadow-[0_0_25px_rgba(0,240,255,0.35)] transition-all">
      <div class="flex flex-col md:flex-row gap-8 items-start md:items-center">
        <div class="relative flex-shrink-0 w-full md:w-[300px]">
          <img src="/images/start.png" alt="Door to Door Website preview"
            class="w-full h-44 object-cover rounded-2xl border border-[#00f0ff]/30 drop-shadow-[0_0_8px_rgba(0,240,255,0.65)]" />
        </div>

        <div class="flex flex-col">
          <span class="font-sans text-xs md:text-sm tracking-[0.2em] uppercase font-medium text-[#00f0ff] mb-2">
            Expo Tech
          </span>

          <h2 class="font-heading text-xl md:text-2xl tracking-wider uppercase font-bold text-[#00f0ff] mb-3 drop-shadow-[0_0_10px_rgba(0,240,255,0.3)]">
            Door to Door - Website
          </h2>

          <p class="font-sans text-white/75 text-sm md:text-base leading-relaxed font-normal mb-6">
            A group web project developed for Expo Logros and consolidated at Expo Tech.
          </p>

          <div>
            <a href="/dd"
              class="inline-block border rounded-2xl px-4 py-2 text-sm md:text-base font-medium border-[#00f0ff]/40 text-[#00f0ff] hover:border-[#00f0ff] hover:drop-shadow-[0_0_8px_rgba(0,240,255,0.8)] transition-all">
              Learn more
            </a>
          </div>
        </div>
      </div>
    </article>

  </main>

  <footer class="w-full text-center py-6 text-xs text-white/40 border-t border-purple-950/50 relative z-10">
    © 2026 Rhina Guardado. All rights reserved.
  </footer>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>
  <script>
    gsap.registerPlugin(ScrollTrigger);

    // Recorre cada tarjeta para que cada una tenga su propio trigger
    gsap.utils.toArray(".card").forEach((card) => {
      gsap.from(card, {
        y: 60,            // sube desde 60px abajo
        opacity: 0,
        duration: 0.8,
        ease: "power3.out",
        scrollTrigger: {
          trigger: card,
          start: "top 85%",   // cuando el top de la tarjeta llega al 85% de la pantalla
          toggleActions: "play none none none"
        },
        // Tus tarjetas tienen "transition-all" de Tailwind y pelea con GSAP
        onStart: () => (card.style.transition = "none"),
        onComplete: () => (card.style.transition = "")
      });
    });
  </script>
</body>

</html>