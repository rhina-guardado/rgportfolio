<!DOCTYPE html>
<html lang="en" class="scroll-smooth">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Portfolio - Rhina Guardado</title>
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <link
    href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;600;700&family=Inter:wght@300;400;500&display=swap"
    rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'sans-serif'],
            heading: ['Space Grotesk', 'sans-serif'],
          }
        }
      }
    }
  </script>
</head>

<body
  class="bg-[#06030e] text-white font-sans min-h-screen relative overflow-x-hidden flex flex-col justify-between selection:bg-purple-500 selection:text-white">

  <main class="w-full max-w-6xl mx-auto px-6 md:px-12 py-8 relative z-10 flex-grow flex flex-col justify-center">

    <!-- Navbar -->
    <header class="w-full pb-14 flex justify-center items-center relative z-10">
      <nav class="hidden md:flex items-center space-x-10 text-lg font-medium text-white/80">
        <a href="http://localhost:3333"
          class="transition-all duration-300 hover:text-white hover:[text-shadow:0_0_15px_rgba(168,85,247,0.8)]">About</a>
        <a href="http://localhost:3333/skills"
          class="transition-all duration-300 hover:text-white hover:[text-shadow:0_0_15px_rgba(168,85,247,0.8)]">Skills</a>
        <a href="http://localhost:3333/projects"
          class="transition-all duration-300 hover:text-white hover:[text-shadow:0_0_15px_rgba(168,85,247,0.8)]">Projects</a>
      </nav>
    </header>

    <!-- 1. Encabezado del Proyecto (misma plantilla alineada de borde a borde) -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-6 mt-4 md:mt-0">
      <h1
        class="text-4xl md:text-5xl tracking-wide text-white font-sans drop-shadow-[0_0_15px_rgba(168,85,247,0.5)]">
        ImDress
      </h1>

      <div class="flex items-center gap-12 md:text-right">
        <div>
          <span class="block text-[10px] font-normal tracking-[0.2em] uppercase text-white/40 mb-1">Timeline</span>
          <span class="text-sm tracking-wide font-normal text-white/90">8 Months (2024)</span>
        </div>

        <div>
          <span class="block text-[10px] tracking-[0.2em] uppercase text-white/40 mb-1">Role</span>
          <span class="text-sm tracking-wide text-white/90">Developer</span>
        </div>
      </div>
    </div>

    <!-- 2. Mockup Principal (centrado y al mismo ancho que toda la plantilla) -->
    <div class="w-full my-12 flex justify-center">
      <img src="/images/hackaton.png" alt="ImDress preview" class="w-full h-auto object-cover rounded-2xl">
    </div>

    <!-- 3. Contenido en dos columnas (Izquierda: Info | Derecha: Tools & Details) -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">

      <!-- Columna Izquierda: About it, Rol & Try It -->
      <div class="space-y-12">
        <div>
          <h2 class="text-2xl tracking-[0.15em] font-light mb-4 drop-shadow-[0_0_15px_rgba(168,85,247,0.5)]">
            About it
          </h2>
          <p class="text-white/70 text-base leading-relaxed font-normal tracking-widest">
            It aims to allow Salvadorans to access a variety of clothing without needing to buy it. To achieve this,
            prices were reduced by renting out suits, costumes, or formal wear imported from other countries and in
            excellent condition.
          </p>
        </div>

        <div>
          <h2 class="text-2xl tracking-[0.15em] font-light mb-4 drop-shadow-[0_0_15px_rgba(168,85,247,0.5)]">
            Rol
          </h2>
          <p class="text-white/70 text-base leading-relaxed tracking-widest">
            Within this project, my specific role consisted of creating and developing the demo in PowerApps, which
            allowed me to have my first experience with these technological tools and learn a bit more about database
            development and management.
          </p>
        </div>

        <div>
          <h2 class="text-2xl tracking-[0.15em] font-light mb-4 hover:drop-shadow-[0_0_15px_rgba(168,85,247,0.5)]">
            ¡Try It!
          </h2>
          <a href="https://apps.powerapps.com/play/e/default-d8e3bd44-0bba-426b-952d-ada7bb17393c/a/49bd9946-4bc3-4ce9-bfce-f442c38c4a94?tenantId=d8e3bd44-0bba-426b-952d-ada7bb17393c&hint=58a58c57-2bd3-402d-92d9-43d132b5802a&sourcetime=1794198931306"
            target="_blank" rel="noopener noreferrer"
            class="text-white/70 hover:text-purple-400 transition-colors text-base leading-relaxed tracking-widest underline underline-offset-4">
            imdress
          </a>
        </div>
      </div>

      <!-- Columna Derecha: Tools & Selected Details -->
      <div class="space-y-12">

        <!-- Tools -->
        <div>
          <h2 class="text-2xl tracking-[0.15em] font-light mb-4 drop-shadow-[0_0_15px_rgba(168,85,247,0.5)]">
            Tools
          </h2>
          <div class="flex flex-wrap gap-2">
            <span class="px-4 py-1.5 bg-[#1b1228] border border-purple-900/50 rounded-lg text-base text-white/80 tracking-wider">Figma</span>
            <span class="px-4 py-1.5 bg-[#1b1228] border border-purple-900/50 rounded-lg text-base text-white/80 tracking-wider">Power Apps</span>
            <span class="px-4 py-1.5 bg-[#1b1228] border border-purple-900/50 rounded-lg text-base text-white/80 tracking-wider">Canva</span>
            <span class="px-4 py-1.5 bg-[#1b1228] border border-purple-900/50 rounded-lg text-base text-white/80 tracking-wider">Share Point</span>
          
          </div>
        </div>

        <!-- Selected Details (Misma plantilla alineada al borde derecho) -->

 <div class="grid grid-cols-2 gap-3">
    <!-- Fila 1: 2 cuadros -->
    <img src="/images/sesion.png" alt=""
      class="min-w-0 w-full aspect-square object-cover object-top rounded-xl border border-purple-900/30 bg-[#120b1e]">

    <img src="/images/menu.png" alt=""
      class="min-w-0 w-full aspect-square object-cover object-top rounded-xl border border-purple-900/30 bg-[#120b1e]">

    <!-- Fila 2: 2 cuadros -->
    <img src="/images/product.png" alt=""
      class="min-w-0 w-full aspect-square object-cover object-top rounded-xl border border-purple-900/30 bg-[#120b1e]">

    <img src="/images/traje.png" alt=""
      class="min-w-0 w-full aspect-square object-cover object-top rounded-xl border border-purple-900/30 bg-[#120b1e]">
  </div>
</div>


























      </div>

    </div>

  </main>

</body>

</html>