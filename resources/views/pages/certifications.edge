<!DOCTYPE html>
<html lang="en" class="scroll-smooth">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Portfolio - Rhina Guardado</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <link
        href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@300;400;500;600&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        heading: ['Space Grotesk', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <style>
        /* Oculta la barra de scroll horizontal manteniendo el desplazamiento fluido */
        .no-scrollbar::-webkit-scrollbar {
            display: none;
        }
        .no-scrollbar {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }
    </style>
</head>

<body
    class="bg-[#05030b] bg-[radial-gradient(ellipse_at_top,rgba(168,85,247,0.14),transparent_55%),radial-gradient(ellipse_at_bottom_right,rgba(0,255,102,0.07),transparent_50%)] text-white font-sans min-h-screen relative overflow-x-hidden flex flex-col justify-between selection:bg-purple-500 selection:text-white">

    <!-- Header fuera de main para que abarque todo el ancho de la pantalla -->
    <header class="w-full px-8 md:px-14 pt-8 pb-6 flex justify-center items-center relative z-10">
       
           
        <nav class="hidden md:flex items-center space-x-10 text-lg font-medium text-white/80">
            <a href="/"
                class="transition-all duration-300 hover:text-white hover:[text-shadow:0_0_15px_rgba(168,85,247,0.8)]">About</a>
            <a href="/certifications"
                class="transition-all duration-300 hover:text-white hover:[text-shadow:0_0_15px_rgba(168,85,247,0.8)]">Certifications</a>
            <a href="/projects"
                class="transition-all duration-300 hover:text-white hover:[text-shadow:0_0_15px_rgba(168,85,247,0.8)]">Projects</a>
        </nav>
    </header>

    <main class="w-full max-w-6xl mx-auto px-6 md:px-12 py-8 relative z-10 flex-grow flex flex-col justify-center">

           <!-- Sección de Certificaciones con desplazamiento horizontal en X -->
        <section class="card w-full mb-20">
            <div class="space-y-8">
                <div class="flex items-center justify-between gap-4">
                    <h2 class="text-2xl md:text-3xl font-heading font-bold tracking-tight text-white flex items-center gap-3">
                        <span class="w-2 h-7 rounded-full bg-purple-400 shadow-[0_0_12px_rgba(168,85,247,0.8)]"></span>
                        Certifications & Recognition
                    </h2>

                    <!-- Controles laterales para deslizar en escritorio -->
                    <div class="flex items-center gap-2">
                        <button type="button" id="cert-prev" aria-label="Scroll left"
                            class="w-10 h-10 rounded-full border border-purple-500/40 bg-[#0d081a]/80 text-white/80 hover:text-white hover:border-purple-400 hover:shadow-[0_0_15px_rgba(168,85,247,0.5)] transition-all flex items-center justify-center">
                            <i class="fa-solid fa-chevron-left text-sm"></i>
                        </button>
                        <button type="button" id="cert-next" aria-label="Scroll right"
                            class="w-10 h-10 rounded-full border border-purple-500/40 bg-[#0d081a]/80 text-white/80 hover:text-white hover:border-purple-400 hover:shadow-[0_0_15px_rgba(168,85,247,0.5)] transition-all flex items-center justify-center">
                            <i class="fa-solid fa-chevron-right text-sm"></i>
                        </button>
                    </div>
                </div>

                <!-- Carrusel horizontal en X -->
                <div id="cert-track"
                    class="flex gap-6 overflow-x-auto snap-x snap-mandatory scroll-smooth no-scrollbar py-2">

                    <!-- Certificación 1: Excel Expert (Verde Neón) -->
                    <div class="w-[290px] sm:w-[330px] flex-shrink-0 snap-start bg-[#0d081a]/80 backdrop-blur-md p-6 rounded-2xl border border-emerald-500/30 hover:border-emerald-400 hover:shadow-[0_0_25px_-5px_rgba(16,185,129,0.3)] transition-all duration-300 flex flex-col justify-between">
                        <div>
                            <div class="flex items-center justify-between mb-4">
                                <span class="text-2xl">📊</span>
                                <span class="text-[10px] font-heading font-bold tracking-widest uppercase text-emerald-400 bg-emerald-500/10 px-2.5 py-1 rounded-full border border-emerald-500/30">
                                    EXCEL / DATA
                                </span>
                            </div>
                            <h3 class="text-lg font-heading font-bold text-white mb-1">
                                Microsoft Office Specialist: Excel Expert
                            </h3>
                            <p class="text-xs font-medium text-emerald-400/80 mb-3">Microsoft</p>
                            <p class="text-sm text-white/65 leading-relaxed mb-5">
                                Advanced formulas, pivot tables, data analysis, and structured spreadsheet workflows.
                            </p>
                        </div>
                        <div class="pt-3 border-t border-white/10 flex items-center justify-between text-xs">
                            <span class="text-white/45 font-mono">2026</span>
                            <a href="/images/expert.png" class="text-emerald-400 hover:text-emerald-300 font-medium inline-flex items-center gap-1">
                                Credential <i class="fa-solid fa-arrow-up-right-from-square text-[10px]"></i>
                            </a>
                        </div>
                    </div>

                    <!-- Certificación 2: TOEIC (Celeste Neón) -->
                    <div class="w-[290px] sm:w-[330px] flex-shrink-0 snap-start bg-[#0d081a]/80 backdrop-blur-md p-6 rounded-2xl border border-cyan-500/30 hover:border-cyan-400 hover:shadow-[0_0_25px_-5px_rgba(34,211,238,0.3)] transition-all duration-300 flex flex-col justify-between">
                        <div>
                            <div class="flex items-center justify-between mb-4">
                                <span class="text-2xl">🌐</span>
                                <span class="text-[10px] font-heading font-bold tracking-widest uppercase text-cyan-400 bg-cyan-500/10 px-2.5 py-1 rounded-full border border-cyan-500/30">
                                    TOEIC / ENGLISH
                                </span>
                            </div>
                            <h3 class="text-lg font-heading font-bold text-white mb-1">
                                TOEIC Listening & Reading
                            </h3>
                            <p class="text-xs font-medium text-cyan-400/80 mb-3">ETS</p>
                            <p class="text-sm text-white/65 leading-relaxed mb-4">
                                International English proficiency certification for academic and professional contexts.
                            </p>
                            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-lg bg-cyan-500/10 border border-cyan-500/25 mb-3">
                                <span class="w-1.5 h-1.5 rounded-full bg-cyan-400 animate-pulse"></span>
                                <span class="text-xs font-mono text-cyan-300">B2 / +690</span>
                            </div>
                        </div>
                        <div class="pt-3 border-t border-white/10 flex items-center justify-between text-xs">
                            <span class="text-white/45 font-mono">2025</span>
                            <a href="/images/silver.jpeg" class="text-cyan-400 hover:text-cyan-300 font-medium inline-flex items-center gap-1">
                                Certificate <i class="fa-solid fa-arrow-up-right-from-square text-[10px]"></i>
                            </a>
                        </div>
                    </div>

                    <!-- Certificación 3: Reconocimiento (Morado Neón) -->
                    <div class="w-[290px] sm:w-[330px] flex-shrink-0 snap-start bg-[#0d081a]/80 backdrop-blur-md p-6 rounded-2xl border border-purple-500/30 hover:border-purple-400 hover:shadow-[0_0_25px_-5px_rgba(168,85,247,0.35)] transition-all duration-300 flex flex-col justify-between">
                        <div>
                            <div class="flex items-center justify-between mb-4">
                                <span class="text-2xl">🏆</span>
                                <span class="text-[10px] font-heading font-bold tracking-widest uppercase text-purple-400 bg-purple-500/10 px-2.5 py-1 rounded-full border border-purple-500/30">
                                    RECOGNITION
                                </span>
                            </div>
                            <h3 class="text-lg font-heading font-bold text-white mb-1">
                                Academic Excellence Award
                            </h3>
                            <p class="text-xs font-medium text-purple-400/80 mb-3">Honor & Distinction</p>
                            <p class="text-sm text-white/65 leading-relaxed mb-5">
                                Recognition for academic consistency, analytical commitment, and collaborative project work.
                            </p>
                        </div>
                        <div class="pt-3 border-t border-white/10 flex items-center justify-between text-xs">
                            <span class="text-white/45 font-mono">2025</span>
                            <a href="/images/excelencia.jpeg" class="text-purple-400 hover:text-purple-300 font-medium inline-flex items-center gap-1">
                                Award <i class="fa-solid fa-arrow-up-right-from-square text-[10px]"></i>
                            </a>
                        </div>
                    </div>

                    <!-- Certificación 4: Excel Associate (Verde Neón) -->
                    <div class="w-[290px] sm:w-[330px] flex-shrink-0 snap-start bg-[#0d081a]/80 backdrop-blur-md p-6 rounded-2xl border border-emerald-500/30 hover:border-emerald-400 hover:shadow-[0_0_25px_-5px_rgba(16,185,129,0.3)] transition-all duration-300 flex flex-col justify-between">
                        <div>
                            <div class="flex items-center justify-between mb-4">
                                <span class="text-2xl">📊</span>
                                <span class="text-[10px] font-heading font-bold tracking-widest uppercase text-emerald-400 bg-emerald-500/10 px-2.5 py-1 rounded-full border border-emerald-500/30">
                                    EXCEL / DATA
                                </span>
                            </div>
                            <h3 class="text-lg font-heading font-bold text-white mb-1">
                                Microsoft Office Specialist: Excel Associate
                            </h3>
                            <p class="text-xs font-medium text-emerald-400/80 mb-3">Microsoft</p>
                            <p class="text-sm text-white/65 leading-relaxed mb-5">
                                Covers essential Excel functions (SUM, AVERAGE, COUNTIF, IF), structured tables, conditional formatting, sorting and filtering, and basic charts to organize and summarize data.
                            </p>
                        </div>
                        <div class="pt-3 border-t border-white/10 flex items-center justify-between text-xs">
                            <span class="text-white/45 font-mono">2025</span>
                            <a href="/images/associate.png" class="text-emerald-400 hover:text-emerald-300 font-medium inline-flex items-center gap-1">
                                Credential <i class="fa-solid fa-arrow-up-right-from-square text-[10px]"></i>
                            </a>
                        </div>
                    </div>

                </div>
            </div>
        </section>
        <h2 class="text-2xl md:text-3xl mt-4 mb-8 font-heading font-bold tracking-tight text-white flex items-center gap-3">
                        <span class="w-2 h-7 rounded-full bg-purple-400 shadow-[0_0_12px_rgba(168,85,247,0.8)]"></span>
                        Skills
                    </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 w-full mb-12">

            <!-- Tarjeta 1: Time Management (Verde neón) -->
            <div
                class="card border border-[#00ff66]/40 bg-[linear-gradient(135deg,rgba(5,25,15,0.72)_0%,rgba(2,12,7,0.88)_100%)] backdrop-blur-md rounded-2xl m-4 p-6 md:p-7 flex flex-col justify-between shadow-[0_0_15px_rgba(0,255,102,0.12)] hover:border-[#00ff66] hover:shadow-[0_0_25px_rgba(0,255,102,0.28)] transition-all">


                <div class="flex flex-col md:flex-row gap-8 items-start">

                    <div class="relative flex-shrink-0">
                        <svg xmlns="http://www.w3.org/2000/svg" width="68" height="68" viewBox="0 0 24 24" fill="none"
                            stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                            class="lucide lucide-clock-check preview-icon mt-1 text-[#00ff66] drop-shadow-[0_0_8px_rgba(0,255,102,0.8)]">
                            <path d="M21.95 13a10 10 0 1 0-8.685 8.92" />
                            <path d="M12 6v6l4 2" />
                            <path d="m16 19 2 2 4-4" />
                        </svg>
                    </div>

                    <div class="flex flex-col">
                        <h2 class="font-heading text-xl md:text-2xl tracking-wider uppercase font-bold text-[#00ff66] mb-3 drop-shadow-[0_0_10px_rgba(0,255,102,0.35)]">
                            Time Management
                        </h2>

                        <p class="font-sans text-white/75 text-sm md:text-base leading-relaxed font-normal">
                            Good time management skills to prioritize tasks, meet deadlines, and stay productive.
                        </p>
                    </div>

                </div>

            </div>

            <!-- Tarjeta 2: Mathematical Analysis (Morado #a855f7) -->
            <div
                class="card border border-purple-500/50 bg-[linear-gradient(135deg,rgba(20,10,38,0.72)_0%,rgba(10,5,20,0.88)_100%)] backdrop-blur-md rounded-2xl m-4 p-6 md:p-7 flex flex-col justify-between shadow-[0_0_15px_rgba(168,85,247,0.16)] hover:border-purple-400 hover:shadow-[0_0_25px_rgba(168,85,247,0.35)] transition-all">

                <div class="flex flex-col md:flex-row gap-8 items-start">

                    <div class="relative flex-shrink-0">
                        <svg xmlns="http://www.w3.org/2000/svg" width="68" height="68" viewBox="0 0 24 24" fill="none"
                            stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                            class="lucide lucide-brain preview-icon mt-1 text-[#a855f7] drop-shadow-[0_0_8px_rgba(168,85,247,0.8)]">
                            <path d="M12 18V5" />
                            <path d="M15 13a4.17 4.17 0 0 1-3-4 4.17 4.17 0 0 1-3 4" />
                            <path d="M17.598 6.5A3 3 0 1 0 12 5a3 3 0 1 0-5.598 1.5" />
                            <path d="M17.997 5.125a4 4 0 0 1 2.526 5.77" />
                            <path d="M18 18a4 4 0 0 0 2-7.464" />
                            <path d="M19.967 17.483A4 4 0 1 1 12 18a4 4 0 1 1-7.967-.517" />
                            <path d="M6 18a4 4 0 0 1-2-7.464" />
                            <path d="M6.003 5.125a4 4 0 0 0-2.526 5.77" />
                        </svg>
                    </div>

                    <div class="flex flex-col">
                        <h2 class="font-heading text-xl md:text-2xl tracking-wider uppercase font-bold mb-3 text-[#a855f7] drop-shadow-[0_0_10px_rgba(168,85,247,0.35)]">
                            Mathematical Analysis
                        </h2>

                        <p class="font-sans text-white/75 text-sm md:text-base leading-relaxed font-normal">
                            Ability to work with data, perform accurate calculations, and understand the logic behind problems.
                        </p>
                    </div>

                </div>

            </div>

            <!-- Tarjeta 3: Fast Learner (Morado #a855f7) -->
            <div
                class="card border border-purple-500/50 bg-[linear-gradient(135deg,rgba(20,10,38,0.72)_0%,rgba(10,5,20,0.88)_100%)] backdrop-blur-md rounded-2xl m-4 p-6 md:p-7 flex flex-col justify-between shadow-[0_0_15px_rgba(168,85,247,0.16)] hover:border-purple-400 hover:shadow-[0_0_25px_rgba(168,85,247,0.35)] transition-all">

                <div class="flex flex-col md:flex-row gap-8 items-start">

                    <div class="relative flex-shrink-0">
                        <svg xmlns="http://www.w3.org/2000/svg" width="68" height="68" viewBox="0 0 24 24" fill="none"
                            stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                            class="lucide lucide-zap preview-icon mt-1 text-[#a855f7] drop-shadow-[0_0_8px_rgba(168,85,247,0.8)]">
                            <path
                                d="M15.914 4a1.5 1.5 0 00-2.474-1.561l-9 9A1.5 1.5 0 005.5 14h4.002a.5.5 0 01.471.666L8.086 20a1.5 1.5 0 002.475 1.56l9-9A1.5 1.5 0 0018.5 10h-3.997a.5.5 0 01-.472-.667z" />
                        </svg>
                    </div>

                    <div class="flex flex-col">
                        <h2 class="font-heading text-xl md:text-2xl tracking-wider uppercase font-bold mb-3 text-[#a855f7] drop-shadow-[0_0_10px_rgba(168,85,247,0.35)]">
                            Fast Learner
                        </h2>

                        <p class="font-sans text-white/75 text-sm md:text-base leading-relaxed font-normal">
                            Quick to adapt and grasp new tools and processes without missing a beat.
                        </p>
                    </div>

                </div>

            </div>

            <!-- Tarjeta 4: Open to feedback (Verde neón) -->
            <div
                class="card border border-[#00ff66]/40 bg-[linear-gradient(135deg,rgba(5,25,15,0.72)_0%,rgba(2,12,7,0.88)_100%)] backdrop-blur-md rounded-2xl m-4 p-6 md:p-7 flex flex-col justify-between shadow-[0_0_15px_rgba(0,255,102,0.12)] hover:border-[#00ff66] hover:shadow-[0_0_25px_rgba(0,255,102,0.28)] transition-all">

                <div class="flex flex-col md:flex-row gap-8 items-start">

                    <div class="relative flex-shrink-0">
                        <svg xmlns="http://www.w3.org/2000/svg" width="68" height="68" viewBox="0 0 24 24" fill="none"
                            stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                            class="lucide lucide-message-square-heart preview-icon mt-1 text-[#00ff66] drop-shadow-[0_0_8px_rgba(0,255,102,0.8)]">
                            <path
                                d="M22 17a2 2 0 0 1-2 2H6.828a2 2 0 0 0-1.414.586l-2.202 2.202A.71.71 0 0 1 2 21.286V5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2z" />
                            <path
                                d="M7.5 9.5c0 .687.265 1.383.697 1.844l3.009 3.264a1.14 1.14 0 0 0 .407.314 1 1 0 0 0 .783-.004 1.14 1.14 0 0 0 .398-.31l3.008-3.264A2.77 2.77 0 0 0 16.5 9.5 2.5 2.5 0 0 0 12 8a2.5 2.5 0 0 0-4.5 1.5" />
                        </svg>
                    </div>

                    <div class="flex flex-col">
                        <h2 class="font-heading text-xl md:text-2xl tracking-wider uppercase font-bold text-[#00ff66] mb-3 drop-shadow-[0_0_10px_rgba(0,255,102,0.35)]">
                            Open to feedback
                        </h2>

                        <p class="font-sans text-white/75 text-sm md:text-base leading-relaxed font-normal">
                            I´m always looking for feedback to do my best and improve myself.
                        </p>
                    </div>

                </div>

            </div>

        </div>

     

    </main>

    <footer class="w-full text-center py-6 text-xs text-white/40 border-t border-purple-950/50 relative z-10">
        © 2026 Rhina Guardado. All rights reserved.
    </footer>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>

    <script>
        gsap.registerPlugin(ScrollTrigger);

        gsap.utils.toArray(".card").forEach((card) => {
            gsap.from(card, {
                y: 60,
                opacity: 0,
                duration: 0.8,
                ease: "power3.out",
                scrollTrigger: {
                    trigger: card,
                    start: "top 85%",
                    toggleActions: "play none none none"
                },
                onStart: () => (card.style.transition = "none"),
                onComplete: () => (card.style.transition = "")
            });
        });

        // Desplazamiento horizontal en X para certificaciones
        const certTrack = document.getElementById("cert-track");
        document.getElementById("cert-prev")?.addEventListener("click", () => {
            certTrack.scrollBy({ left: -350, behavior: "smooth" });
        });
        document.getElementById("cert-next")?.addEventListener("click", () => {
            certTrack.scrollBy({ left: 350, behavior: "smooth" });
        });
    </script>

</body>

</html>