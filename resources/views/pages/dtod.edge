<!DOCTYPE html>
<html lang="en" class="scroll-smooth">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Portfolio - Rhina Guardado</title>
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <link
    href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;600;700&family=Inter:wght@300;400;500&display=swap"
    rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'sans-serif'],
            heading: ['Space Grotesk', 'sans-serif'],
          }
        }
      }
    }
  </script>
</head>


<body
  class="bg-[#06030e] text-white font-sans min-h-screen relative overflow-x-hidden flex flex-col justify-between selection:bg-purple-500 selection:text-white">

  <main class="w-full max-w-6xl mx-auto px-6 md:px-12 py-8 relative z-10 flex-grow flex flex-col justify-center">



    <header class="w-full px-6 :px-16 pb-14 flex justify-center items-center relative z-10 max-w-7xl mx-auto">
      <nav class="hidden md:flex items-center space-x-10 text-lg font-medium text-white/80">
        <a href="http://localhost:3333"
          class="transition-all duration-300 hover:text-white hover:[text-shadow:0_0_15px_rgba(168,85,247,0.8)]">About</a>
        <a href="http://localhost:3333/skills"
          class="transition-all duration-300 hover:text-white hover:[text-shadow:0_0_15px_rgba(168,85,247,0.8)]">Skills</a>
        <a href="http://localhost:3333/projects"
          class="transition-all duration-300 hover:text-white hover:[text-shadow:0_0_15px_rgba(168,85,247,0.8)]">Projects</a>
      </nav>
    </header>



    <body
      class="bg-[#06030e] text-white font-sans min-h-screen relative overflow-x-hidden flex flex-col justify-between selection:bg-purple-500 selection:text-white">






      <div class="flex gap-10 mt-4 md:mt-0 text-center justify-between">

        <h1
          class="text-4xl md:text-5xl tracking-wide m-4 text-white font-sans drop-shadow-[0_0_15px_rgba(168,85,247,0.5)]">
          Door to Door- Prototype</h1>

        <div>
          <span class="block text-[10px] font-normal tracking-[0.2em] uppercase text-white/40 m-4">Timeline</span>
          <span class="text-sm tracking-wide font-normal text-white/90">8 Months (2026)</span>
        </div>


        <div>
          <span class="block text-[10px] tracking-[0.2em] uppercase text-white/40 m-4">Role</span>
          <span class="text-sm tracking-wide text-white/90">Developer</span>
        </div>


      </div>


      <!-- 3. Mockup de la App / Tarjeta de Presentación Superior -->
      <div class="justify-center">
        <img src="/images/dtod.png" alt="" width="1000" height="960" class="m-12">
      </div>
      <!-- 4. Contenido en dos columnas (Izquierda: Info | Derecha: Tools & Details) -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16">

        <!-- Columna Izquierda: About it & Rol -->
        <div class="space-y-12">
          <div>
            <h2 class="text-2xl tracking-[0.15em] font-light mb-4 drop-shadow-[0_0_15px_rgba(168,85,247,0.5)]">About it
            </h2>
            <p class="text-white/70 text-base leading-relaxed font-normal tracking-widest">
              It consists of connecting Salvadorans living abroad with products from their home country. To achieve
              this, a website was created that housed agencies in charge of these processes along with their information
              and contact details. Additionally, it features a section for independent couriers and the option to
              compare agencies to select the one that best suits their needs.
            </p>
          </div>

          <div>
            <h2 class="text-2xl tracking-[0.15em] font-light mb-4 drop-shadow-[0_0_15px_rgba(168,85,247,0.5)]">Rol</h2>
            <p class="text-white/70 text-base leading-relaxed tracking-widest">
              Personally, I contributed to the project by bringing the design, features, and user experience to life on
              the Figma platform.
            </p>
          </div>

          <div>
            <h2 class="text-2xl tracking-[0.15em] font-light mb-4 hover:drop-shadow-[0_0_15px_rgba(168,85,247,0.5)] ">
              ¡Try It!</h2>
            <a href="https://www.figma.com/proto/4i0JfYkxuc5d3dUvJHGdj3/G1---DoorToDoor?node-id=156-260&t=00U4goXyyUD70pW3-1"
              class="text-white/70 text-base leading-relaxed tracking-widest"> Door to Door </a>
          </div>






        </div>

        <!-- Columna Derecha: Tools & Selected Details -->
        <div class="space-y-12">

          <!-- Tools (Etiquetas) -->
          <div>
            <h2 class="text-2xl tracking-[0.15em] font-light mb-4 drop-shadow-[0_0_15px_rgba(168,85,247,0.5)]">Tools
            </h2>
            <div class="flex flex-wrap gap-2">
              <span
                class="px-4 py-1.5 bg-[#1b1228] border border-purple-900/50 rounded-lg text-base text-white/80 tracking-wider">Figma</span>
            
              <span
                class="px-4 py-1.5 bg-[#1b1228] border border-purple-900/50 rounded-lg  text-base text-white/80 tracking-wider">Canva</span>
              <span
                class="px-4 py-1.5 bg-[#1b1228] border border-purple-900/50 rounded-lg  text-base text-white/80 tracking-wider">Youtube</span>
              <span
                class="px-4 py-1.5 bg-[#1b1228] border border-purple-900/50 rounded-lg  text-base text-white/80 tracking-wider">Lucidchart</span>
              <span
                class="px-4 py-1.5 bg-[#1b1228] border border-purple-900/50 rounded-lg text-base text-white/80 tracking-wider">Draw.io</span>
             
            </div>
          </div>

          <!-- Selected Details -->
          <div>
            <h2 class="text-2xl tracking-[0.15em] font-light mb-4 drop-shadow-[0_0_15px_rgba(168,85,247,0.5)]">Selected Details</h2>
            <div class="grid grid-cols-2 gap-4">

              <!-- Tarjeta galería mini 1 -->

              <img src="/images/logind.png" alt="" class="w-200 h-48 object-cover rounded-xl">

              <!-- Imagen 2 -->
              <img src="/images/card.png" alt="" class="w-400 h-48 object-cover rounded-xl">
              <!-- Imagen 3 -->

              <img src="/images/prices.png" alt="" class="w-400 h-48 object-cover rounded-xl">

              <!-- Imagen 4 -->
              <img src="/images/agency.png" alt=""  class="w-200 h-48 object-cover rounded-xl -ml-28">



            </div>
          </div>

        </div>

      </div>

  </main>

</body>

</html>




</div>
</body>